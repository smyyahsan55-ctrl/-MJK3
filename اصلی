def normalize_text(text):
    if not text:
        return ""
    text = unicodedata.normalize('NFKC', str(text))
    text = text.replace('\u200c', ' ').replace('\u200f', '').replace('\u200e', '')
    text = text.replace('\u200b', '')
    text = re.sub(r'\s+', ' ', text)
    return text.strip()


