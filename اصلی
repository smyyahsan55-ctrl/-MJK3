@main_bot.on_new_message()
async def main_handler(bot: Bot, event):
    try:
        cid = str(event.chat_id)
        raw = event.text or ""
        txt = resolve_button(raw)

        if not is_private_chat(cid):
            return

        logger.info(f"📩 {cid[:15]} raw={raw!r} → {txt!r}")

        user = await get_user(cid)
